{$NTFY_DOMAIN}, 
{$NTFY_CANONICAL_URL}, 
{$NTFY_CONVENIENCE_URL} {
	tls {
		dns porkbun {
			api_key {env.PORKBUN_API_KEY}
			api_secret_key {env.PORKBUN_SECRET_KEY}
		}
	}
	reverse_proxy {$NTFY_HOST}:{$NTFY_PORT}

	@httpget {
		protocol http
		method GET
		path_regexp ^/([-_a-z0-9]{0,64}$|docs/|static/)
	}
	redir @httpget https://{host}{uri}

	log {
		level INFO
		output stdout
		#level ERROR
		#format console
	}
}

