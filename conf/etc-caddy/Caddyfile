{
	admin unix//run/caddy-admin.sock
	admin localhost:2019

	servers {
		trusted_proxies static private_ranges
	}

	#log {
	#		level INFO
	#		format json
	#		output stderr
	#		#format console
	#		#level ERROR
	#	}

	# Everything else, unsampled
	log default {
		output stdout
		format json
		exclude http.log.error.ha
	}

	# Only the noisy one, sampled
	log ha_err_sampled {
		output stdout
		format json
		level ERROR
		include http.log.error.ha
		sampling {
			interval 30000000000
			first 1
			thereafter 500
		}
	}

	email {env.CADDY_EMAIL}
}

{$VAULTWARDEN_CANONICAL_URL}, 
{$VAULTWARDEN_CANONICAL_LAN_URL}, 
{$VAULTWARDEN_CONVENIENCE_URL}, 
{$VAULTWARDEN_GRANDFATHERED_URL} {
	tls {
		dns porkbun {
			api_key {env.PORKBUN_API_KEY}
			api_secret_key {env.PORKBUN_SECRET_KEY}
		}
	}
	reverse_proxy {$VAULTWARDEN_HOST}:{$VAULTWARDEN_PORT}
	log {
		level DEBUG
		output stdout
		#level ERROR
		#format console
	}
}

