{
	admin unix//run/caddy-admin.sock
	admin localhost:2019

	servers {
		trusted_proxies static private_ranges
	}

	log {
		level INFO
		format json
		output stderr
		#format console
		#level ERROR
	}
	email {env.CADDY_EMAIL}
}

{$VAULTWARDEN_CANONICAL_URL}, 
{$VAULTWARDEN_CONVENIENCE_URL}, 
{$VAULTWARDEN_GRANDFATHERED_URL} {
	tls {
		dns porkbun {
			api_key {env.PORKBUN_API_KEY}
			api_secret_key {env.PORKBUN_SECRET_KEY}
		}
	}
	reverse_proxy {$VAULTWARDEN_HOST}:{$VAULTWARDEN_PORT}
	log {
		level DEBUG 
		output stdout
		#level ERROR
		#format console
	}
}

